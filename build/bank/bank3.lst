c63f : a60a             [ 3] 	ldx vdp_delay					; 3
c641 : f003             [ 3] 	beq vdp_mem_wait_end			; 3
c643 :                       vdp_mem_wait_loop
c643 : ca               [ 2] 	dex								; 2
c644 : d0fd             [ 3] 	bne	vdp_mem_wait_loop			; 3
c646 :                       vdp_mem_wait_end
c646 : fa               [ 4] 	plx								; 3
c647 : 60               [ 6] 	rts								; 6
                             	
