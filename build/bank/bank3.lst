                             ; -------------------------------------
d8e2 :                       FIX16BITS       ; INT(256*2*1000/1773) = 289 = 25
                                             ; Homebrew is 1.34Mhz
                                             ; So calculation = 386 = 256 + 12
                                             ; IN:  register A is low byte
                                             ;      register X is high byte
                                             ; OUT: register Y is low byte
                                             ;      register X is high byte
                             
d8e2 : 86f8             [ 3]         stx TA1         ; Reg 1 = 256*AX
d8e4 : 85fa             [ 3]         sta TB1
d8e6 : 86f9             [ 3]         stx TA2         ; Reg 2 = 256*AX
d8e8 : 85fb             [ 3]         sta TB2
d8ea : 64fd             [ 3]         stz TC2
d8ec : 86fe             [ 3]         stx TB3         ; Reg 3 = AX
d8ee : 85ff             [ 3]         sta TC3
                                     
                                     ; x128 for homebrew
                                     ; which is same as right shift 1 time of 
d8f0 : 46f9             [ 5]         lsr TA2
d8f2 : 66fb             [ 5]         ror TB2
d8f4 : 66fd             [ 5]         ror TC2
                                             
                                     ; x02 + x128 for homebrew
                                     ; shift reg 3 left, the carry added to re
d8f6 : 06ff             [ 5]         asl TC3
d8f8 : 26fe             [ 5]         rol TB3
d8fa : a5f9             [ 3]         lda TA2
d8fc : 6900             [ 2]         adc #0
d8fe : 85f9             [ 3]         sta TA2
                                     ; Now add the rest of reg 3 to reg 2
d900 : a5ff             [ 3]         lda TC3
d902 : 65fd             [ 3]         adc TC2
d904 : 85fd             [ 3]         sta TC2
d906 : a5fe             [ 3]         lda TB3
d908 : 65fb             [ 3]         adc TB2
d90a : 85fb             [ 3]         sta TB2
d90c : a900             [ 2]         lda #0
d90e : 65f9             [ 3]         adc TA2
d910 : 85f9             [ 3]         sta TA2
                             
                                     ; Add reg 2(x128+x2) to reg 1(x256) and t
d912 : a5fb             [ 3]         lda TB2
d914 : 65fa             [ 3]         adc TB1
d916 : a8               [ 2]         tay         ; sta TB1
d917 : a5f9             [ 3]         lda TA2
d919 : 65f8             [ 3]         adc TA1
                                     ; sta TA1
                             
                                     ; / 2 (16bits)
d91b : 4a               [ 2]         lsr a         ; lsr TA1
d91c : aa               [ 2]         tax         ; ldx TA1
d91d : 98               [ 2]         tya         ; lda TB1     
d91e : 6a               [ 2]         ror a         ; ror TB1
d91f : a8               [ 2]         tay         ; ldy TB1
d920 : 60               [ 6]         rts 
                             
                             ; HB-BBC-128 settings:
AS65 Assembler for R6502 [1.42].                                     Page   87
---------------------------------- bank3.s -----------------------------------

                             ;* AY-3-8910 definitions
                             ;* The sound chip is accessed through VIA 2
0480 =                       IO_1		= 0x0480
0000 =                       PRB		= 0x00
0001 =                       PRA		= 0x01
0002 =                       DDRB		= 0x02
0003 =                       DDRA		= 0x03
0481 =                       SND_ADBUS	= IO_1+PRA
0480 =                       SND_MODE	= IO_1+PRB
                             
0040 =                       SND_SELREAD		= 0x40
0002 =                       SND_SELWRITE		= 0x02
0042 =                       SND_SELSETADDR		= (SND_SELREAD|SND_SELWRITE)
00bd =                       SND_DESELECT_MASK	= (0xff-SND_SELREAD-SND_SELWRIT
                             
                             
                             ;****************************************
                             ;* ay_set
                             ;* Set AY register A to value X
                             ;* Input : A = Reg no, X = Value
                             ;* Output : None
                             ;* Regs affected : None
                             ;****************************************
d921 :                       ay_set
d921 : 48               [ 3]         pha
                             
d922 : a9ff             [ 2] 	lda #0xff			; Set Port A to output
d924 : 8d8304           [ 4] 	sta IO_1 + DDRA
                             
d927 : 68               [ 4]         pla
d928 : 8d8104           [ 4] 	sta SND_ADBUS			; Put A on the sound bus (A = re
                             
d92b : ad8004           [ 4] 	lda SND_MODE			; Need to preserve contents of ot
d92e : 29bd             [ 2] 	and #SND_DESELECT_MASK	        ; Mask off mode b
d930 : 0942             [ 2] 	ora #SND_SELSETADDR		; Select AY mode to latch a
