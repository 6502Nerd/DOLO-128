                             	data				; Set vectors
fffa =                       	org 0xfffa			; Vectors lie at addresses
fffa : 4ac7                  	fcw call_nmi_master	; 0xfffa : NMI Vector
fffc : 67cb                  	fcw init			; 0xfffc : Reset Vector
fffe : 87c7                  	fcw call_irq_master	; 0xfffe : IRQ Vector
                             	
                             	; ROM code
