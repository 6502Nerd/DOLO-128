d797 : 8486             [ 3] 	sty num_tmp+1
d799 : 8679             [ 3] 	stx num_a			; num_a contains the line number to 
d79b : 857a             [ 3] 	sta num_a+1
d79d :                       df_pg_check_next_line	; Also used during runtime 
d79d : a585             [ 3] 	lda num_tmp
