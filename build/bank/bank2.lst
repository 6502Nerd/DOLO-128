c013 : 4c74c6           [ 3] 	jmp snd_set				; Vec 6
c016 : 4c30c6           [ 3] 	jmp vdp_wr_addr			; Vec 7
c019 : 4c48c6           [ 3] 	jmp	vdp_rd_addr			; Vec 8
c01c : 4c9bc6           [ 3] 	jmp snd_get				; Vec 9
c01f :                       _restore_bank
                             	; Save A
c01f : 8500             [ 3] 	sta tmp_bank1
                             	; Get old bank from stack
c021 : 68               [ 4] 	pla
c022 : 8501             [ 3] 	sta tmp_bank2
c024 : ad0004           [ 4] 	lda IO_0+PRB
c027 : 293f             [ 2] 	and #ROM_ZMASK
c029 : 0501             [ 3] 	ora tmp_bank2
c02b : 8d0004           [ 4] 	sta IO_0+PRB
                             	
                             	; Restore A
c02e : a500             [ 3] 	lda tmp_bank1
                             
c030 : 60               [ 6] 	rts
                             
