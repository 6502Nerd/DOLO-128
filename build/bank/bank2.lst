ce03 : 0649             [ 5] 	asl sd_addr+3
ce05 : 2648             [ 5] 	rol sd_addr+2
ce07 : 2647             [ 5] 	rol sd_addr+1
ce09 : 2646             [ 5] 	rol sd_addr+0
                             
