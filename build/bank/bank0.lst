                             ;****************************************
                             ;* fill_vram
                             ;* Fill a number of VRAM bytes with a value
                             ;* Input : X,Y = Fill length (lo,hi), A = Value
                             ;* Output : None
                             ;* Regs affected : All
                             ;* ASSUMES vdp_wr_vram already called
                             ;* Works for < 256 bytes as long as Y=1
                             ;* Else only use for WHOLE pages at a time so X m
                             ;* INTERRUPTS MUST HAVE BEEN DISABLED BY THE CALL
                             ;****************************************
dced :                       vdp_fill_vram
dced : 2058c6           [ 6] 	jsr vdp_wr_vram
dcf0 : ca               [ 2] 	dex
dcf1 : d0fa             [ 3] 	bne vdp_fill_vram
dcf3 : 88               [ 2] 	dey
dcf4 : d0f7             [ 3] 	bne vdp_fill_vram
dcf6 : 60               [ 6] 	rts
                             
                             ;****************************************
                             ;* clear_vram
                             ;* Set all 16k VDP vram to 0x00
                             ;* Input : None
                             ;* Output : None
                             ;* Regs affected : All
                             ;****************************************
dcf7 :                       clear_vram
dcf7 : a200             [ 2] 	ldx #0x00			; Low byte of address
dcf9 : a900             [ 2] 	lda #0x00			; High byte of address
dcfb : 2030c6           [ 6] 	jsr vdp_wr_addr		; Write address to VDP
                             
dcfe : a040             [ 2] 	ldy #0x40			; 0x40 pages = 16k (X already zero)
dd00 : 20eddc           [ 6] 	jsr vdp_fill_vram
dd03 : 60               [ 6] 	rts
                             	
                             ;****************************************
                             ;* init_colours_g1
                             ;* Initialise colour table for graphics 1
                             ;* Input : None
                             ;* Output : None
                             ;* Regs affected : All
                             ;****************************************
dd04 :                       init_colours_g1
dd04 : 08               [ 3] 	php
dd05 : 78               [ 2] 	sei
dd06 : a60d             [ 3] 	ldx vdp_base+vdp_addr_col
