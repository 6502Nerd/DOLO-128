                             ;****************************************
                             ;* vdp_mem_wait
                             ;* Delay some time before a memory access,
                             ;* taking in to account mode 9918 needs up
                             ;* to 3.1uS for text mode, 8uS for graphics
                             ;* I and II
                             ;* @ 5.35Mhz	= 16 cycles for 3.1uS
                             ;*				= 43 cycles for 8uS
                             ;* Input : None
                             ;* Output : None
                             ;* Regs affected : None
                             ;****************************************
c63e :                       vdp_mem_wait
c63e : da               [ 3] 	phx								; 3
c63f : a60a             [ 3] 	ldx vdp_delay					; 3
c641 : f003             [ 3] 	beq vdp_mem_wait_end			; 3
c643 :                       vdp_mem_wait_loop
c643 : ca               [ 2] 	dex								; 2
c644 : d0fd             [ 3] 	bne	vdp_mem_wait_loop			; 3
c646 :                       vdp_mem_wait_end
c646 : fa               [ 4] 	plx								; 3
c647 : 60               [ 6] 	rts								; 6
                             	
