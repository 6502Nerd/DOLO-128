d226 : a9ff             [ 2] 	lda #0xff			
d228 : 8d0304           [ 4] 	sta IO_0 + DDRA				; Port A all output
                             
d22b : a9fe             [ 2] 	lda #0xfe					; Make sure all outputs are high!
d22d : 8d0004           [ 4] 	sta IO_0 + PRB
                             	
d230 : 8d0204           [ 4] 	sta IO_0 + DDRB				; Port B output for leds and 
                             
d233 : a900             [ 2] 	lda #0x00					; Init control register - nothing 
d235 : 8d0b04           [ 4] 	sta IO_0 + ACR
d238 : a902             [ 2] 	lda #0x02					; CA2 independent interrupt
