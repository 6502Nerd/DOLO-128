                             ;****************************************
                             ;* init_fonts_sub
                             ;* Initialise fonts common subroutine
                             ;* Input : X,A contains vram address
                             ;* Output : None
                             ;* Regs affected : All
                             ;* INTERRUPTS MUST HAVE BEEN DISABLED BY CALLER!!
                             ;****************************************
dd56 :                       init_fonts_sub
dd56 : 08               [ 3] 	php
dd57 : 78               [ 2] 	sei
dd58 : 2030c6           [ 6] 	jsr vdp_wr_addr			; Write the address
dd5b : 6435             [ 3] 	stz tmp_a				; XOR with zero = no change
dd5d : a000             [ 2] 	ldy #0					; byte within page
dd5f :                       init_write_fonts
dd5f : a900             [ 2] 	lda #lo(vdp_font)		; Low byte of fonts source
dd61 : 8533             [ 3] 	sta tmp_v1
dd63 : a9d8             [ 2] 	lda #hi(vdp_font)		; High byte of fonts source
dd65 : 8534             [ 3] 	sta tmp_v1+1
dd67 : a204             [ 2] 	ldx #0x04				; 4 pages = 1024 bytes
dd69 :                       init_pattern
dd69 : 98               [ 2] 	tya
dd6a : b133             [ 5] 	lda (tmp_v1),y			; Get byte from font table
dd6c : 4535             [ 3] 	eor tmp_a				; Invert if tmp_a is 0xff
dd6e : 2058c6           [ 6] 	jsr vdp_wr_vram			; Write the byte to VRAM
dd71 : c8               [ 2] 	iny
dd72 : d0f5             [ 3] 	bne init_pattern		; keep going for 1 page
dd74 : e634             [ 5] 	inc tmp_v1+1			; only need to increment high byt
dd76 : ca               [ 2] 	dex						; page counter
dd77 : d0f0             [ 3] 	bne init_pattern		; keep going for 4 pages
dd79 : a535             [ 3] 	lda tmp_a				; get the current eor mask
dd7b : 49ff             [ 2] 	eor	#0xff				; Invert the EOR mask
dd7d : 8535             [ 3] 	sta tmp_a				; And save for next go around
dd7f : d0de             [ 3] 	bne init_write_fonts
dd81 : 28               [ 4] 	plp
dd82 : 60               [ 6] 	rts
                             
