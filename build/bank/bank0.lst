                             ;*  OSVEC.S
                             ;*  Simply this is a bunch of JMP XXXX the order 
                             ;*  will always be maintained.  This is to allow 
                             ;*  code programs to be able to rely on fixed loc
                             ;*  some key low-level functions.
                             ;*  Only low level functions are needed, the idea
                             ;*  as the assembler is part of the BASIC, one ca
                             ;*  level slow stuff using BASIC then switch to M
                             ;*  speed up.
                             ;*  This code goes straight after the bank number
                             ;*  Each JMP is at 0xc001+3*(vector #)
                             ;*
                             ;************************************************
                             
c001 : 4c93c5           [ 3] 	jmp	io_put_ch			; Vec 0
c004 : 4c90c5           [ 3] 	jmp io_get_ch			; Vec 1
c007 : 4c23c6           [ 3] 	jmp vdp_wr_reg			; Vec 2
c00a : 4c5dc6           [ 3] 	jmp vdp_poke			; Vec 3
c00d : 4c6ac6           [ 3] 	jmp vdp_peek			; Vec 4
c010 : 4cccc6           [ 3] 	jmp snd_get_joy0		; Vec 5
c013 : 4c74c6           [ 3] 	jmp snd_set				; Vec 6
c016 : 4c30c6           [ 3] 	jmp vdp_wr_addr			; Vec 7
c019 : 4c48c6           [ 3] 	jmp	vdp_rd_addr			; Vec 8
c01c : 4c9bc6           [ 3] 	jmp snd_get				; Vec 9
c01f :                       _restore_bank
                             	; Save A
c01f : 8500             [ 3] 	sta tmp_bank1
                             	; Get old bank from stack
c021 : 68               [ 4] 	pla
c022 : 8501             [ 3] 	sta tmp_bank2
c024 : ad0004           [ 4] 	lda IO_0+PRB
c027 : 293f             [ 2] 	and #ROM_ZMASK
c029 : 0501             [ 3] 	ora tmp_bank2
c02b : 8d0004           [ 4] 	sta IO_0+PRB
                             	
                             	; Restore A
c02e : a500             [ 3] 	lda tmp_bank1
                             
c030 : 60               [ 6] 	rts
                             
