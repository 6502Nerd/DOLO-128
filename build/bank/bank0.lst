                             ;	ldx #RTC_HRA
                             ;	jsr rtc_write
                             ;	; Also clear day of week (not used yet)
                             ;	ldx #RTC_DOW
                             ;	jsr rtc_write
                             
                             	; Default is binary mode, 24 hour clock, no dayl
d485 : a20b             [ 2] 	ldx #RTC_REGB
d487 : a906             [ 2] 	lda #RTC_DM | RTC_2412
d489 : 206ad4           [ 6] 	jsr rtc_write
                             
