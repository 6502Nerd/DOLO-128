                             ;* Include all common code in the right order
                             	include "io\io.s"
                             ;************************************************
                             ;*
                             ;*	BBC-128 HOMEBREW COMPUTER
                             ;*	Hardware and software design by @6502Nerd (Dol
                             ;*	Copyright 2014-20
                             ;*  Free to use for any non-commercial purpose su
                             ;*  appropriate credit of my authorship please!
                             ;*
                             ;*  IO.S
                             ;*  General IO module.  Allows different IO devic
                             ;*  utilised transparently by the rest of the cod
                             ;*  Other code should use "io_" commands so that 
                             ;*  do not need to know what specific device is p
                             ;*  input and output capabilities.  On startup, t
                             ;*  examines the BBC DIP switch to decide whether
                             ;*  initialise the IO to serial through the ACIA 
                             ;*  the BBC keyboard for input with the VDP for o
                             ;*  Loading and saving files from the SD card is 
                             ;*  achieved by pointing to SD card get and put b
                             ;*  routines.
                             ;*
                             ;************************************************
                             
                             	; ROM code
                             	code
                             
c559 :                       mod_sz_io_s
                             
                             ;****************************************
                             ;* io_init
                             ;* Initialise the default device and make active
                             ;* No keys pressed = serial (default)
AS65 Assembler for R6502 [1.42].                                     Page   26
---------------------------------- bank0.s -----------------------------------

                             ;* F0 pressed = KB/VDP
                             ;* F1 pressed = Serial
                             ;* Keyboard and screen or serial port
                             ;* Output : None
                             ;* Regs affected : P, A
                             ;****************************************
c559 :                       io_init
c559 : a900             [ 2] 	lda #0				; Assume it's serial
c55b : 48               [ 3] 	pha
c55c : 20a1c2           [ 6] 	jsr _kb_read_dip	; Check DIPs if 0xff then assum
c55f : 2910             [ 2] 	and #0x10
c561 : d00b             [ 3] 	bne io_init_set_default
c563 : 2089c2           [ 6] 	jsr _kb_read_raw	; Check pressed key
c566 : e081             [ 2] 	cpx #0x81			; f1 key pressed (i.e. boot up in se
c568 : f004             [ 3] 	beq io_init_set_default
                             	; Else set to KB/screen for IO
c56a : 68               [ 4] 	pla
c56b : a901             [ 2] 	lda #1
c56d : 48               [ 3] 	pha
c56e :                       io_init_set_default
c56e : 68               [ 4] 	pla
c56f : 8d500c           [ 4] 	sta io_default
c572 : 4c75c5           [ 3] 	jmp io_set_default	; Activate the default device
                             
                             ;****************************************
                             ;* io_set_default, io_active_device
                             ;* Activate device based on default or A
                             ;* Input : A = Device number
                             ;* Output : None
                             ;* Regs affected : P, A
                             ;****************************************
c575 :                       io_set_default			; Entry point for default
c575 : ad500c           [ 4] 	lda io_default
c578 :                       io_active_device		; Entry point for A set
c578 : 0a               [ 2] 	asl	a				; x16 the Block number
c579 : 0a               [ 2] 	asl a
c57a : 0a               [ 2] 	asl a
c57b : 0a               [ 2] 	asl a
c57c : a8               [ 2] 	tay
c57d : a200             [ 2] 	ldx #0
                             	; Copy device settings to io block
c57f :                       io_copy_data
c57f : b9f3c5           [ 4] 	lda io_devices,y
c582 : 9d510c           [ 5] 	sta io_block,x
c585 : c8               [ 2] 	iny
c586 : e8               [ 2] 	inx
c587 : e010             [ 2] 	cpx #io_struct
c589 : d0f4             [ 3] 	bne io_copy_data
                             	
c58b : a90d             [ 2] 	lda #UTF_CR		; Line terminator is CR
c58d : 853e             [ 3] 	sta buf_ef
c58f : 60               [ 6] 	rts
                             
                             ;****************************************
                             ;* io_get_ch
                             ;* Get a char (wait forever or just check)
                             ;* Input : C = 1 for synchronous, 0 for async
                             ;* Output : A = Byte code, C = 0 means A is inval
                             ;* Regs affected : P, A
                             ;****************************************
c590 :                       io_get_ch
c590 : 6c510c           [ 6] 	jmp (io_block+io_get_byte)
AS65 Assembler for R6502 [1.42].                                     Page   27
---------------------------------- bank0.s -----------------------------------

                             	
                             
                             ;****************************************
                             ;* io_put_ch
                             ;* Put a char
                             ;* Input : A = char
                             ;* Regs affected : P, A
                             ;****************************************
c593 :                       io_put_ch
c593 : 6c530c           [ 6] 	jmp (io_block+io_put_byte)
                             	
                             ;****************************************
                             ;* io_open_read
                             ;* Open for reading
                             ;* Input : X,A = pointer to filename (zero termin
                             ;* Output : C=0 success
                             ;* Regs affected : All
                             ;****************************************
c596 :                       io_open_read
c596 : 6c550c           [ 6] 	jmp (io_block+io_open_r)
                             	
                             ;****************************************
                             ;* io_open_write
                             ;* Open for reading
                             ;* Input : X,A = pointer to filename (zero termin
                             ;* Output : C=0 success
                             ;* Regs affected : All
                             ;****************************************
c599 :                       io_open_write
c599 : 6c570c           [ 6] 	jmp (io_block+io_open_w)
                             
                             ;****************************************
                             ;* io_close
                             ;* Close a file
                             ;* Input : 
                             ;* Output : C=0 success
                             ;* Regs affected : All
                             ;****************************************
c59c :                       io_close
c59c : 6c590c           [ 6] 	jmp (io_block+io_close_f)
                             	
                             ;****************************************
                             ;* io_delete
                             ;* Delete a file
                             ;* Input : 
                             ;* Output : C=0 success
                             ;* Regs affected : All
                             ;****************************************
c59f :                       io_delete
c59f : 6c5b0c           [ 6] 	jmp (io_block+io_del_f)
                             	
                             ;****************************************
                             ;* io_read_line
                             ;* Read a line, terminated by terminating char or
                             ;* Input : buf_(sz/ef) : Address, Max size, end m
                             ;*		    X,A = destination (uses buf_adr)
                             ;*		    Y=max line length
                             ;* Output : Y = Line length C = Buffer limit reac
                             ;* Regs affected : None
                             ;****************************************
c5a2 :                       io_read_line
c5a2 : 863b             [ 3] 	stx buf_adr			; Save pointer to storage
AS65 Assembler for R6502 [1.42].                                     Page   28
---------------------------------- bank0.s -----------------------------------

c5a4 : 853c             [ 3] 	sta buf_adr+1
c5a6 : 843d             [ 3] 	sty buf_sz			; Max length
c5a8 : 08               [ 3] 	php					; Save echo state
c5a9 : a000             [ 2] 	ldy #0x00			; Starting at first byte
c5ab :                       io_get_line_byte
c5ab : 38               [ 2] 	sec					; Getting bytes synchronously
c5ac : 2090c5           [ 6] 	jsr io_get_ch		; Get a byte
c5af : b026             [ 3] 	bcs io_get_line_done; Got nothing then finish
c5b1 : 28               [ 4] 	plp					; Get echo state
c5b2 : 08               [ 3] 	php					; Instantly save it back
c5b3 : 900c             [ 3] 	bcc io_skip_echo	; Carry not set = don't echo
c5b5 : c97f             [ 2] 	cmp #UTF_DEL		; Delete?
c5b7 : d005             [ 3] 	bne io_do_echo
c5b9 : c000             [ 2] 	cpy #0				; Already at beginning?
c5bb : f004             [ 3] 	beq io_skip_echo	; Don't echo delete
c5bd : 88               [ 2] 	dey					; Else decrement length
c5be :                       io_do_echo
c5be : 2093c5           [ 6] 	jsr io_put_ch		; Echo it
c5c1 :                       io_skip_echo
c5c1 : c920             [ 2] 	cmp #UTF_SPECIAL	; Special character?
c5c3 : 9007             [ 3] 	bcc io_skip_special	; Skip if so (don't add to b
c5c5 : c97f             [ 2] 	cmp #UTF_DEL		; Don't proces DEL either
c5c7 : f003             [ 3] 	beq io_skip_special
c5c9 : 913b             [ 5] 	sta (buf_adr),y		; Save it
c5cb : c8               [ 2] 	iny					; Increase length
c5cc :                       io_skip_special
c5cc : c53e             [ 3] 	cmp buf_ef			; Is it the terminating char?
c5ce : f007             [ 3] 	beq io_get_line_done	; If yes then done
c5d0 : c43d             [ 3] 	cpy buf_sz			; Reached the buffer max size?
c5d2 : d0d7             [ 3] 	bne io_get_line_byte	; No, get another byte
c5d4 : 28               [ 4] 	plp					; Remember to pull echo state off stack
c5d5 : 38               [ 2] 	sec					; Yes, set carry flag
c5d6 : 60               [ 6] 	rts					; And done
c5d7 :                       io_get_line_done
c5d7 : a900             [ 2] 	lda #0
c5d9 : 913b             [ 5] 	sta (buf_adr),y		; Terminate with 0
c5db : 28               [ 4] 	plp					; Remember to pull echo state off stack
c5dc : 18               [ 2] 	clc					; Clear carry flag
c5dd : 60               [ 6] 	rts					; Fin
                             
                             ;****************************************
                             ;* io_print_line
                             ;* Print a line (when data is not already in seri
                             ;* Input : X = Address Lo, A = Address Hi
                             ;* Output : Y=number chars output
                             ;* Regs affected : All
                             ;****************************************
c5de :                       io_print_line
c5de : 48               [ 3] 	pha
                             
c5df : 8631             [ 3] 	stx tmp_c					; Store the string pointer
