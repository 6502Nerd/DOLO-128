d21e : 8d0e04           [ 4] 	sta IO_0 + IER
d221 : a9ff             [ 2] 	lda #0xff					; Clear IFR
d223 : 8d0d04           [ 4] 	sta IO_0 + IFR				; Set IFR to clear flags
                             	
