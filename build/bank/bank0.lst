                             ;* and if suspect then offer option to
                             ;* set date-time.
                             ;* Check NV ram and warn if bad
                             ;****************************************
d47e :                       rtc_init
                             	; No interrupts
d47e : a20c             [ 2] 	ldx #RTC_REGC
d480 : a900             [ 2] 	lda #0
d482 : 206ad4           [ 6] 	jsr rtc_write
                             	
