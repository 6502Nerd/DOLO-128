d679 : 09                    	db 0x09				; R12 = Envelope Period High
d67a : 00                    	db 0b00000000		; R13 = Envelope Shape : 0000
d67b : 00                    	db 0x00				; R14 = IO Port A
d67c : 00                    	db 0x00				; R15 = IO Port B ; Initialise to 0
                             
