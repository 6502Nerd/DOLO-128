                             	; Now we are in the right folder to write the fi
                             	; Need to open the file using the filename at st
                             	; Get X,A to point to this
d1af : 18               [ 2] 	clc
d1b0 : a902             [ 2] 	lda #recv_block_payload
d1b2 : 6900             [ 2] 	adc #lo(recv_buffer)
d1b4 : aa               [ 2] 	tax
d1b5 : a90b             [ 2] 	lda #hi(recv_buffer)
d1b7 : 6900             [ 2] 	adc #0
                             	; Print filename
d1b9 : 48               [ 3] 	pha
d1ba : da               [ 3] 	phx
d1bb : 20dec5           [ 6] 	jsr io_print_line
d1be : fa               [ 4] 	plx
d1bf : 68               [ 4] 	pla
                             	; Now open for write
d1c0 : 20f1c0           [ 6] 	jsr _fs_open_write_w
d1c3 : b003             [ 3] 	bcs block0_error
                             	; Set flag indicating file is opened
d1c5 : ee010a           [ 6] 	inc recv_fopen
d1c8 :                       block0_error
d1c8 : 60               [ 6] 	rts
                             
                             ; Process data block payload
d1c9 :                       recv_process_blockn
                             ;	_recv_print recv_got_block_msg
d1c9 : 18               [ 2] 	clc
d1ca : ad010b           [ 4] 	lda recv_buffer+recv_block_payload_sz
d1cd : 6d020a           [ 4] 	adc recv_szlo
d1d0 : 8d020a           [ 4] 	sta recv_szlo
d1d3 : aa               [ 2] 	tax
d1d4 : ad030a           [ 4] 	lda recv_szhi
d1d7 : 6900             [ 2] 	adc #0
d1d9 : 8d030a           [ 4] 	sta recv_szhi	
d1dc : 20d2d0           [ 6] 	jsr recv_print_block
d1df : a200             [ 2] 	ldx #0
d1e1 :                       recv_process_blockn_byte
                             	; Get byte from buffer
d1e1 : bd020b           [ 4] 	lda recv_buffer+recv_block_payload,x
                             	; Write to file previously opened for write
d1e4 : 2009c1           [ 6] 	jsr _fs_put_byte_w
d1e7 : e8               [ 2] 	inx
                             	; Processed all bytes?
d1e8 : ec010b           [ 4] 	cpx recv_buffer+recv_block_payload_sz
