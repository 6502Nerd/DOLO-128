d602 : 9133             [ 5] 	sta (tmp_v1),y
d604 : c8               [ 2] 	iny
d605 : a207             [ 2] 	ldx #RTC_DAY
d607 : 2074d4           [ 6] 	jsr rtc_read
d60a : 9133             [ 5] 	sta (tmp_v1),y
d60c : c8               [ 2] 	iny
d60d : a208             [ 2] 	ldx #RTC_MTH
d60f : 2074d4           [ 6] 	jsr rtc_read
d612 : 9133             [ 5] 	sta (tmp_v1),y
d614 : c8               [ 2] 	iny
d615 : a209             [ 2] 	ldx #RTC_YR
d617 : 2074d4           [ 6] 	jsr rtc_read
d61a : 9133             [ 5] 	sta (tmp_v1),y
d61c : 4cf7d4           [ 3] 	jmp rtc_resumeupdate
                             
                             ;**************************************
                             ;* rtc_nvvalid
                             ;* Validate nvram checksum
                             ;* C=1 means ERROR
                             ;* Simple 8 bit sum of all bytes should
                             ;* result in a zero. Partial sum carry
                             ;* is used.
                             ;* Uses A,X
                             ;**************************************
d61f :                       rtc_nvvalid
d61f : a20e             [ 2] 	ldx #14
d621 : a900             [ 2] 	lda #0
d623 : 8533             [ 3] 	sta tmp_v1
d625 :                       rtc_nvvalid_loop
d625 : 2074d4           [ 6] 	jsr rtc_read
d628 : 18               [ 2] 	clc
d629 : 6533             [ 3] 	adc tmp_v1
d62b : 8533             [ 3] 	sta tmp_v1
d62d : e8               [ 2] 	inx
d62e : e040             [ 2] 	cpx #NV_RAMSZ+1
d630 : d0f3             [ 3] 	bne rtc_nvvalid_loop
d632 : a533             [ 3] 	lda tmp_v1
                             	; A-1 will be C=1 if A>=1
d634 : c901             [ 2] 	cmp #1
d636 : 60               [ 6] 	rts
                             
AS65 Assembler for R6502 [1.42].                                     Page   84
---------------------------------- bank0.s -----------------------------------

                             ;**************************************
                             ;* rtc_nvwrite
                             ;* Write to nvram location X, value A
                             ;* Checksum (byte 127) is also updated
                             ;**************************************
d637 :                       rtc_nvwrite
                             	; Write to required nv location
d637 : 206ad4           [ 6] 	jsr rtc_write
                             	; Zero out checksum location
d63a : a23f             [ 2] 	ldx #NV_RAMSZ
d63c : a900             [ 2] 	lda #0
d63e : 206ad4           [ 6] 	jsr rtc_write
                             	; Get new checksum by calling validator
d641 : 201fd6           [ 6] 	jsr rtc_nvvalid
                             	; Calculate checksum by making 2s complement
d644 : 49ff             [ 2] 	eor #0xff
d646 : 18               [ 2] 	clc
d647 : 6901             [ 2] 	adc #1
                             	; Write new checksum
d649 : a23f             [ 2] 	ldx #NV_RAMSZ
d64b : 206ad4           [ 6] 	jsr rtc_write
d64e : 60               [ 6] 	rts
                             
                             ;**************************************
                             ;* rtc_nvread
                             ;* Read from nvram location X
                             ;* Value in A
                             ;* C=1 if checksum failed
                             ;**************************************
d64f :                       rtc_nvread
                             	; Read nv location
d64f : 2074d4           [ 6] 	jsr rtc_read
                             	; Remember while validating checksum
d652 : 48               [ 3] 	pha
                             	; Validate checksum (C=0 if OK)
d653 : 201fd6           [ 6] 	jsr rtc_nvvalid
                             	; Retrieve the location read
d656 : 68               [ 4] 	pla
                             	; C=0 if OK and A is valid
d657 : 60               [ 6] 	rts
                             
d658 :                       mod_sz_rtc_e
                             
                             
                             	include "sound\sound.s"
                             ;************************************************
                             ;*
                             ;*	BBC-128 HOMEBREW COMPUTER
                             ;*	Hardware and software design by @6502Nerd (Dol
                             ;*	Copyright 2014-20
                             ;*  Free to use for any non-commercial purpose su
                             ;*  appropriate credit of my authorship please!
                             ;*
                             ;*  SOUND.S
                             ;*  Sound driver module - routines to access the 
                             ;*  This sound chip was found in a number of popu
                             ;*  in the early to mid 80s, including my first c
                             ;*  the Oric-1, as well as the MSX range.  Interf
                             ;*  chip is through port A of VIA 2 because it ca
                             ;*  connected directly to the 6502 bus.  This mea
                             ;*  is a bit clunky to drive, but this is how the
                             ;*  did it, so even though I came up with this in
AS65 Assembler for R6502 [1.42].                                     Page   85
---------------------------------- bank0.s -----------------------------------

                             ;*  I guess I can't be too wrong with this approa
                             ;*  The AY doesn't only produce sound, it also ha
                             ;*  of 8 bit IO port - one of them I am using for
                             ;*
                             ;*  NOTE:	As part of the ROM banking strategy, th
                             ;*			lowest level routines have been factored out
                             ;*			to the 'kernel' which means they are present
                             ;*			in every code bank.
                             ;*
                             ;************************************************
                             
                             
                             	; ROM code
                             	code
                             
d658 :                       mod_sz_sound_s
                             
                             
                             ;****************************************
                             ;* snd_get_note
                             ;* Get a note from the music scale table
                             ;* Input : Y
                             ;* Output : A,X = Value hi,lo
                             ;* Regs affected : X
                             ;****************************************
d658 :                       snd_get_note
d658 : be7dd6           [ 4] 	ldx snd_music_tab,y
d65b : b97ed6           [ 4] 	lda snd_music_tab+1,y
d65e : 60               [ 6] 	rts
                             
                             	
                             ;****************************************
                             ;* init_snd
                             ;* Initialise sound - after cia 1 has been initia
                             ;* Input : None
                             ;* Output : None
                             ;* Regs affected : All
                             ;****************************************
d65f :                       init_snd
d65f : a200             [ 2] 	ldx #0x00
d661 :                       init_snd_regs
d661 : bc6dd6           [ 4] 	ldy snd_init_tab,x
d664 : 2074c6           [ 6] 	jsr snd_set				; Set X to Y
d667 : e8               [ 2] 	inx
d668 : e010             [ 2] 	cpx #16					; Done 16?
d66a : d0f5             [ 3] 	bne init_snd_regs		; Nope	
                             	
d66c : 60               [ 6] 	rts						; return from sub
                             
                             	; Register array initialisation values
                             	; Assuming 1.34Mhz input clock
d66d :                       snd_init_tab
d66d : 80                    	db 0x80				; R0 = Channel A Tone Low
d66e : 00                    	db 0x00				; R1 = Channel A Tone High
d66f : 00                    	db 0x00				; R2 = Channel B Tone Low
d670 : 01                    	db 0x01				; R3 = Channel B Tone High
d671 : 00                    	db 0x00				; R4 = Channel C Tone Low
d672 : 02                    	db 0x02				; R5 = Channel C Tone High
d673 : 00                    	db 0x00				; R6 = Noise period
d674 : 3e                    	db 0b00111110		; R7 = Control : IOB input, IOA i
d675 : 1f                    	db 0x1f				; R8 = Channel A Vol
d676 : 1f                    	db 0x1f				; R9 = Channel B Vol
AS65 Assembler for R6502 [1.42].                                     Page   86
