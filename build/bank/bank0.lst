                             ;*
                             ;*  SERIAL.S
                             ;*  Serial input/output handler - driving a 6551 
                             ;*  To handle WDC65c51 bug on transmit, use a del
                             ;*  to ensure byte is transmitted before the next
                             ;*
                             ;************************************************
                             
                             	; ROM code
                             	code
                             
                             
                             ;****************************************
                             ;* ser_get_byte
                             ;* Get a byte (wait forever or just check)
                             ;* Input : C = 1 for synchronous, 0 for async
                             ;* Output : A = Byte code, C = 1 means A is inval
                             ;* Regs affected : P, A
                             ;****************************************
d26f :                       ser_get_byte
d26f : a502             [ 3] 	lda ser_first			; if first==last then buffer emp
d271 : 4503             [ 3] 	eor ser_last
d273 : d004             [ 3] 	bne ser_got_byte
d275 : b0f8             [ 3] 	bcs ser_get_byte
d277 : 38               [ 2] 	sec
d278 : 60               [ 6] 	rts
d279 :                       ser_got_byte
d279 : 5a               [ 3] 	phy
d27a : a402             [ 3] 	ldy ser_first			; Get first byte in FIFO
d27c : b90008           [ 4] 	lda ser_buf,y
d27f : e602             [ 5] 	inc ser_first			; Advance first byte of FIFO
d281 : 7a               [ 4] 	ply
d282 : 18               [ 2] 	clc						; Indicate byte was got
d283 : 60               [ 6] 	rts
                             
                             
                             ;****************************************
                             ;* ser_put_byte
                             ;* Put a byte out
                             ;* Input : A = Byte to put
                             ;* Output : None
                             ;* Regs affected : None
                             ;****************************************
d284 :                       ser_put_byte
d284 : 48               [ 3] 	pha						; Save A
                             ;	phx
                             ;	ldx #112				; Loop 112 times
d285 :                       ser_put_byte_wait				; Delay 2512 cycles (19200bp
                             ;	nop						; For 5.36Mhz clock
                             ;	nop						; ~25 cycles per loop (10xnop+dex+bne)
                             ;	nop						; 
                             ;	nop						; 
                             ;	nop						; 
                             ;	nop						; 
                             ;	nop						; 
                             ;	nop						; 
                             ;	nop						; 
                             ;	nop						; 
                             ;	dex						;
d285 : ad8105           [ 4] 	lda SER_STATUS			; Check status register
AS65 Assembler for R6502 [1.42].                                     Page   73
---------------------------------- bank0.s -----------------------------------

d288 : 2910             [ 2] 	and #SER_TDRE			; Is transmit reg empty?
d28a : f0f9             [ 3] 	beq ser_put_byte_wait	; Keep waiting if not
                             ;	plx						; restore X
d28c : 68               [ 4] 	pla						; Get A back
d28d : 8d8005           [ 4] 	sta SER_DATA			; Write the data
d290 : 60               [ 6] 	rts
                             
                             
                             ;****************************************
                             ;* init_acia
                             ;* ACIA initialisation (this is IO_3)
                             ;* Input : None
                             ;* Output : None
                             ;* Regs affected : X
                             ;****************************************
d291 :                       init_acia
d291 : a200             [ 2] 	ldx #0
d293 : 8602             [ 3] 	stx ser_first			; Initialise FIFO buffer pointer
d295 : 8603             [ 3] 	stx ser_last
d297 : 8e8105           [ 4] 	stx SER_RESET			; Reset 6551
d29a : a21f             [ 2] 	ldx #0b00011111			; 19200 baud, 8 bits, 1 stop b
d29c : 8e8305           [ 4] 	stx SER_CTL
d29f : a209             [ 2] 	ldx #0b00001001			; No parity, no TX int plus RT
d2a1 : 8e8205           [ 4] 	stx SER_CMD
d2a4 : ae8105           [ 4] 	ldx SER_STATUS			; Read status reg to clear stuf
                             
d2a7 : 60               [ 6] 	rts
                             
                             	include "keyboard\keyboard.s"
                             ;************************************************
                             ;*
                             ;*	BBC-128 HOMEBREW COMPUTER
                             ;*	Hardware and software design by @6502Nerd (Dol
                             ;*	Copyright 2014-20
                             ;*  Free to use for any non-commercial purpose su
                             ;*  appropriate credit of my authorship please!
                             ;*
                             ;*  KEYBOARD.S
                             ;*  This is the keyboard module to enable interfa
                             ;*  BBC keyboard using a 65c22.  The BBC keyboard
                             ;*  in that it provides a signal to know if somet
                             ;*  pressed in hardware, so the more cycle heavy 
                             ;*  actually check which key etc can be done only
                             ;*  necessary.  Debouncing is necessary to not sc
                             ;*  often, with the timing for this happening dur
                             ;*  interrupt cycle.
                             ;*
                             ;************************************************
                             
                             	; ROM code
                             	code
                             
                             ;****************************************
                             ;* init_keyboard
                             ;* Initialise the keyboard settings
                             ;****************************************
d2a8 :                       init_keyboard
d2a8 : a914             [ 2] 	lda #KB_REP_DEL
d2aa : 852e             [ 3] 	sta kb_rep_del
d2ac : a903             [ 2] 	lda #KB_REP_TIM
d2ae : 852d             [ 3] 	sta kb_rep_tim
d2b0 : a902             [ 2] 	lda #KB_DEBOUNCE
AS65 Assembler for R6502 [1.42].                                     Page   74
---------------------------------- bank0.s -----------------------------------

d2b2 : 852f             [ 3] 	sta kb_debounce
d2b4 : 642a             [ 3] 	stz kb_stat
d2b6 : 60               [ 6] 	rts
                             	
                             
                             ;****************************************
                             ;* kb_read_raw
                             ;* Read keyboard (not shift+ctrl)
                             ;* X = Keyboard code
                             ;* Carry = 1 means key found, 0 = no keys found
                             ;****************************************
d2b7 :                       kb_read_raw
d2b7 : 48               [ 3] 	pha
d2b8 : 5a               [ 3] 	phy
                             
d2b9 : a901             [ 2] 	lda #KB_W				; This is the mask to look for
d2bb : a000             [ 2] 	ldy #0					; Start at row 1, column 0, KB_EN is 
d2bd :                       kb_check_w_col
d2bd : a207             [ 2] 	ldx #7					; Only 7 rows as row zero is skipped
d2bf : c8               [ 2] 	iny						; Increment past row 0
d2c0 :                       kb_check_w_key
d2c0 : 8c0104           [ 4] 	sty IO_0 + PRA			; Set the row and column with K
d2c3 : ea               [ 2] 	nop						; Short delay for fast CPU
d2c4 : ea               [ 2] 	nop						; Short delay for fast CPU
d2c5 : 2c0004           [ 4] 	bit IO_0 + PRB			; Bit test for the W status
d2c8 : d00b             [ 3] 	bne got_key				; Found key
d2ca : c8               [ 2] 	iny						; Advance row
d2cb : ca               [ 2] 	dex						; Do each row
d2cc : d0f2             [ 3] 	bne kb_check_w_key
d2ce : c050             [ 2] 	cpy #0b01010000			; If not got to column 10 then
d2d0 : d0eb             [ 3] 	bne kb_check_w_col
                             
d2d2 :                       kb_no_key
                             	; no key found
d2d2 : 18               [ 2] 	clc						; Clear carry flag = no keys found
d2d3 : 8045             [ 4] 	bra kb_raw_done			; Exit nicely
                             
d2d5 :                       got_key
d2d5 : 8427             [ 3] 	sty kb_raw				; Save the raw key code
d2d7 : beb8d3           [ 4] 	ldx kb_table_std,y		; Load up standard key code 
d2da : a900             [ 2] 	lda #0b00000000			; Check shift pressed (row=0, 
d2dc : 8d0104           [ 4] 	sta IO_0 + PRA
d2df : ea               [ 2] 	nop						; Short delay for fast CPU
d2e0 : ea               [ 2] 	nop						; Short delay for fast CPU
d2e1 : ad0004           [ 4] 	lda IO_0 + PRB			; Read w
d2e4 : 2901             [ 2] 	and #KB_W
d2e6 : d006             [ 3] 	bne do_shifted_key
d2e8 : a52a             [ 3] 	lda kb_stat
d2ea : 2902             [ 2] 	and #KB_SHIFTLK			; Check shift lock
d2ec : f003             [ 3] 	beq skip_shifted_key	
d2ee :                       do_shifted_key
d2ee : be09d4           [ 4] 	ldx kb_table_shift,y	; Overwrite X with shifted 
d2f1 :                       skip_shifted_key
d2f1 : a908             [ 2] 	lda #0b00001000			; Check ctrl pressed (row=0, c
d2f3 : 8d0104           [ 4] 	sta IO_0 + PRA
d2f6 : ea               [ 2] 	nop						; Short delay for fast CPU
d2f7 : ea               [ 2] 	nop						; Short delay for fast CPU
d2f8 : ad0004           [ 4] 	lda IO_0 + PRB			; Read w
d2fb : 2901             [ 2] 	and #KB_W
d2fd : f006             [ 4] 	beq skip_ctrl_key
d2ff : 8a               [ 2] 	txa						; If ctrl pressed then only take bottom
d300 : 291f             [ 2] 	and #0x1f				; Which will result in codes 0 to 3
AS65 Assembler for R6502 [1.42].                                     Page   75
---------------------------------- bank0.s -----------------------------------

d302 : aa               [ 2] 	tax
d303 : 8012             [ 3] 	bra skip_caps_lock		; no point in checking caps 
d305 :                       skip_ctrl_key
d305 : a52a             [ 3] 	lda kb_stat				; Check caps lock
d307 : 2901             [ 2] 	and #KB_CAPSLK
d309 : f00c             [ 3] 	beq skip_caps_lock
d30b : 8a               [ 2] 	txa						; Easier to modify in A
d30c : c961             [ 2] 	cmp #'a'				; If < 'a' then skip
d30e : 9007             [ 3] 	bcc skip_caps_lock
d310 : c97b             [ 2] 	cmp #'z'+1				; If > 'z' then skip
d312 : b003             [ 3] 	bcs skip_caps_lock
d314 : 4920             [ 2] 	eor #0x20				; Switch off bit 0x20
d316 : aa               [ 2] 	tax						; to make upper case
d317 :                       skip_caps_lock
d317 : 8629             [ 3] 	stx kb_code				; Store mapped key code
d319 : 38               [ 2] 	sec						; Set carry flag = key found
                             	
d31a :                       kb_raw_done
d31a : a080             [ 2] 	ldy #KB_EN				; Re-enable h/w strobe
d31c : 8c0104           [ 4] 	sty IO_0 + PRA
d31f : 7a               [ 4] 	ply
d320 : 68               [ 4] 	pla
d321 : 60               [ 6] 	rts
                             
                             	
                             ;****************************************
                             ;* kb_read_dip
                             ;* Scans options dip switch
                             ;* A = Options code for all 8 bits
                             ;****************************************
d322 :                       kb_read_dip
d322 : 5a               [ 3] 	phy
                             
d323 : a000             [ 2] 	ldy #0
d325 : 6435             [ 3] 	stz tmp_a
d327 :                       kb_check_dip
d327 : b95ad4           [ 4] 	lda kb_dip_code, y		; Binary dip code, row = 0, 
d32a : 8d0104           [ 4] 	sta IO_0 + PRA
d32d : ea               [ 2] 	nop						; Short delay for fast CPU
d32e : ea               [ 2] 	nop						; Short delay for fast CPU
d32f : ad0004           [ 4] 	lda IO_0 + PRB			; Read w
d332 : 2901             [ 2] 	and #KB_W
d334 : f007             [ 3] 	beq kb_skip_dip
d336 : a535             [ 3] 	lda tmp_a
d338 : 1962d4           [ 4] 	ora kb_dip_bit, y		; Set the bit if option on
d33b : 8535             [ 3] 	sta tmp_a
d33d :                       kb_skip_dip
d33d : c8               [ 2] 	iny
d33e : c008             [ 2] 	cpy #8
d340 : d0e5             [ 3] 	bne kb_check_dip
d342 : a535             [ 3] 	lda tmp_a
                             
d344 : a080             [ 2] 	ldy #KB_EN				; Re-enable h/w strobe
d346 : 8c0104           [ 4] 	sty IO_0 + PRA
                             
d349 : 7a               [ 4] 	ply
d34a : 60               [ 6] 	rts
                             	
                             	
                             ;****************************************
                             ;* kb_scan_key
                             ;* Scans for a key, returns zero for no key found
AS65 Assembler for R6502 [1.42].                                     Page   76
---------------------------------- bank0.s -----------------------------------

                             ;* Processes caps and shift lock but these don't 
                             ;* A = Key code
