d24f : 8d8e04           [ 4] 	sta IO_1 + IER
                             	
d252 : a9ff             [ 2] 	lda #0xff					; Port A all output (AY-3 data bus
d254 : 8d8304           [ 4] 	sta IO_1 + DDRA
                             	
d257 : a920             [ 2] 	lda #MM_DIS					; Make sure ROM is enabled in po
d259 : 8d8004           [ 4] 	sta IO_1+PRB				; setting the data direction reg
                             	
d25c : a97b             [ 2] 	lda #0b01111011				; Set Port B input/output SD,
d25e : 8d8204           [ 4] 	sta IO_1+DDRB
                             	
